# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server-only signing secret; generate a unique random value for each environment
HMAC_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy variable supported by the app; the publishable key above is preferred.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# External service adapters (mock mode is enabled by default)
USE_MOCK_SERVICES=true
MOCK_OTP_CODE=123456
E2E_TEST_MODE=false

# Real providers (required when USE_MOCK_SERVICES=false)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Portal login credentials (required in production)
HOSPITAL_DEMO_PIN=
SUPERADMIN_EMAIL=
SUPERADMIN_PIN=
