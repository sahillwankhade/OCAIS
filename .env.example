MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

RAZORPAY_KEY_ID=rzp_test_mock12345
RAZORPAY_KEY_SECRET=rzp_mock_secret_key

