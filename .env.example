# One Click AIS (OCAIS) Environment Configuration

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Security
HMAC_SECRET_KEY=dev-secret-key-change-in-production-ocais-2026

# Supabase (Configured for local / cloud instance)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.mock_anon_key
SUPABASE_SERVICE_ROLE_KEY=mock_service_role_key

# External Service Adapters (Mock Mode enabled by default)
USE_MOCK_SERVICES=true
MOCK_OTP_CODE=123456

# Optional Real Providers (Active when USE_MOCK_SERVICES=false)
